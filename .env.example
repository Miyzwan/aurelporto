# Supabase project URL (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key — browser and user-scoped server clients
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key — server-only. Never expose via NEXT_PUBLIC_*.
# Used exclusively by lib/supabase/secret.ts for the validated public inquiry insert.
SUPABASE_SECRET_KEY=

# Canonical site origin, used for metadata, sitemap, and auth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000
